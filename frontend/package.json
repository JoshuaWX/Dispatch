{
  "name": "my-project",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:db": "supabase test db && node scripts/test-migration.mjs",
    "test:e2e": "playwright test",
    "test:lighthouse": "npm run build && node scripts/lighthouse.mjs",
    "audit": "npm audit --omit=dev --audit-level=high",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build && npm run audit"
  },
  "dependencies": {
    "@google/genai": "2.22.0",
    "@supabase/supabase-js": "^2.101.1",
    "ipaddr.js": "2.5.0",
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tldts": "7.4.12",
    "undici": "8.10.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "^26",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.0.1",
    "axe-playwright": "2.2.2",
    "eslint": "10.10.0",
    "eslint-config-next": "16.3.5",
    "jsdom": "30.1.0",
    "lighthouse": "^13.4.1",
    "postcss": "^8.5",
    "tailwindcss": "^4.2.0",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  },
  "overrides": {
    "@humanfs/node": "0.17.0",
    "baseline-browser-mapping": "2.11.23",
    "browserslist": "4.28.9",
    "brace-expansion@>=3": "5.0.9",
    "ws": "8.21.3"
  }
}
