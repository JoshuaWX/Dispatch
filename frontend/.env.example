# Required database connection. Service-role access is server-only and must never use NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Safe containment default. Set true only after migration, staging smoke test, and 48-hour soak.
PIPELINE_PUBLISHING_ENABLED=false

# Separate high-entropy bearer tokens for operators and the Supabase Cron scheduler.
OPS_ADMIN_TOKEN=
SCHEDULER_SECRET=

# The only allowed editorial model/provider.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
AI_MONTHLY_BUDGET_USD=1.00
AI_BUDGET_WARNING_USD=0.80

# Permitted topic discovery and publisher search providers. No key is exposed to the browser.
# NewsAPI Developer keys and unapproved metered Virlo access are not used by the pipeline.
THENEWSAPI_KEY=
NEWSDATA_API_KEY=

# Public canonical origin, without a trailing slash.
NEXT_PUBLIC_SITE_URL=https://dispatch-1news.vercel.app
